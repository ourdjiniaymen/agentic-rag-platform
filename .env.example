# Postgres
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentic_rag
POSTGRES_HOST=db
POSTGRES_PORT=5432

# NOTE: DATABASE_URL is intentionally not set here - docker-compose.yml
# composes it from the POSTGRES_* vars above, so there's one source of
# truth. If you ever run Alembic/uvicorn outside Docker, export
# DATABASE_URL yourself for that shell.

# OpenAI
OPENAI_API_KEY=sk-changeme
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o

# Storage (local disk, per DECISIONS.md 007)
STORAGE_ROOT=/app/storage

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# App
ENV=development
