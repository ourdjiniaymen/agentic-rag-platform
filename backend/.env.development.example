# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# OpenAI
OPENAI_API_KEY=sk-
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o
embedding_batch_size=100

# Chunking
chunk_max_characters=1500
chunk_new_after_n_chars=1200
chunk_combine_text_under_n_chars=300

# Retrieving
retrieval_top_k=5
retrieval_similarity_threshold=0.4

# Storage (local disk, per DECISIONS.md 007)
STORAGE_ROOT=/app/storage

# App
ENV=development
